import boto3
import pandas as pd
from datetime import datetime, timedelta
import time
import csv

# Initialize AWS clients
config_client = boto3.client('config')
athena_client = boto3.client('athena')
s3_client = boto3.client('s3')

# Configuration
CONFIG_AGGREGATOR_NAME = 'your-aggregator-name'  # Replace with your Config aggregator name
ATHENA_DATABASE = 'your_athena_database'         # Replace with your Athena database name
ATHENA_TABLE = 'cloudtrail_logs'                 # Replace with your CloudTrail table name
OUTPUT_S3_BUCKET = 'your-output-bucket'          # Replace with your output S3 bucket
OUTPUT_S3_PREFIX = 'security-group-changes/'     # S3 prefix for Athena results
OUTPUT_CSV_FILE = 'security_group_changes_with_users.csv'

def run_config_aggregator_query(query):
    """Run query against AWS Config aggregator and return results"""
    response = config_client.select_aggregate_resource_config(
        Expression=query,
        ConfigurationAggregatorName=CONFIG_AGGREGATOR_NAME
    )
    
    results = []
    while True:
        results.extend(response['Results'])
        if 'NextToken' in response:
            response = config_client.select_aggregate_resource_config(
                Expression=query,
                ConfigurationAggregatorName=CONFIG_AGGREGATOR_NAME,
                NextToken=response['NextToken']
            )
        else:
            break
    
    return [eval(item) for item in results]

def run_athena_query(query, database, output_location):
    """Run Athena query and return results"""
    query_id = athena_client.start_query_execution(
        QueryString=query,
        QueryExecutionContext={
            'Database': database
        },
        ResultConfiguration={
            'OutputLocation': output_location
        }
    )['QueryExecutionId']
    
    # Wait for query to complete
    while True:
        status = athena_client.get_query_execution(QueryExecutionId=query_id)
        state = status['QueryExecution']['Status']['State']
        if state in ['SUCCEEDED', 'FAILED', 'CANCELLED']:
            break
        time.sleep(1)
    
    if state != 'SUCCEEDED':
        raise Exception(f'Athena query failed: {status}')
    
    # Get results
    results = []
    paginator = athena_client.get_paginator('get_query_results')
    for page in paginator.paginate(QueryExecutionId=query_id):
        results.extend(page['ResultSet']['Rows'])
    
    # Convert to list of dicts
    if not results:
        return []
    
    headers = [col['VarCharValue'] for col in results[0]['Data']]
    return [
        {header: col['VarCharValue'] for header, col in zip(headers, row['Data'])}
        for row in results[1:]
    ]

def get_security_group_changes():
    """Get security group changes from AWS Config"""
    query = """
    SELECT
        resourceId,
        awsRegion,
        awsAccountId,
        configurationItemCaptureTime,
        configurationItemStatus,
        configuration.eventName,
        configuration.eventTime
    WHERE
        resourceType = 'AWS::EC2::SecurityGroup'
        AND (
            configurationItemStatus = 'ResourceDiscovered'
            OR configurationItemStatus = 'OK'
            OR configurationItemStatus = 'ResourceDeleted'
        )
        AND (
            configuration.eventName IN ('AuthorizeSecurityGroupIngress', 'AuthorizeSecurityGroupEgress',
                                     'RevokeSecurityGroupIngress', 'RevokeSecurityGroupEgress',
                                     'CreateSecurityGroup', 'DeleteSecurityGroup')
            OR configurationItemStatus = 'ResourceDeleted'
        )
    """
    return run_config_aggregator_query(query)

def get_user_info_for_change(change):
    """Query Athena to find who made a specific security group change"""
    change_time = datetime.strptime(change['configurationItemCaptureTime'], '%Y-%m-%dT%H:%M:%S.%fZ')
    start_time = (change_time - timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')
    end_time = (change_time + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')
    
    query = f"""
    SELECT
        eventtime,
        useridentity.type as identity_type,
        useridentity.arn as user_arn,
        useridentity.principalid as principal_id,
        useridentity.accountid as user_account_id,
        useridentity.username as username,
        useridentity.sessioncontext.sessionissuer.arn as assumed_role_arn,
        eventname,
        sourceipaddress,
        useragent
    FROM {ATHENA_TABLE}
    WHERE
        eventtime BETWEEN timestamp '{start_time}' AND timestamp '{end_time}'
        AND awsregion = '{change['awsRegion']}'
        AND eventsource = 'ec2.amazonaws.com'
        AND eventname IN ('AuthorizeSecurityGroupIngress', 'AuthorizeSecurityGroupEgress',
                         'RevokeSecurityGroupIngress', 'RevokeSecurityGroupEgress',
                         'CreateSecurityGroup', 'DeleteSecurityGroup')
        AND NOT (
            useridentity.type = 'AssumedRole'
            AND useridentity.sessioncontext.sessionissuer.arn LIKE '%:role/aws-service-role/cloudformation.amazonaws.com/AWSServiceRoleForCloudFormation%'
        )
        AND (
            -- Match by resource ARN pattern
            regexp_like(resources[1].arn, '.*{change['resourceId']}.*')
            OR
            -- Or match by request parameters for some events
            (
                json_extract_scalar(requestparameters, '$.groupId') = '{change['resourceId']}'
                OR json_extract_scalar(requestparameters, '$.groupid') = '{change['resourceId']}'
                OR json_extract_scalar(requestparameters, '$.groupName') = '{change['resourceId']}'
            )
        )
    ORDER BY eventtime DESC
    LIMIT 1
    """
    
    output_location = f's3://{OUTPUT_S3_BUCKET}/{OUTPUT_S3_PREFIX}'
    results = run_athena_query(query, ATHENA_DATABASE, output_location)
    return results[0] if results else None

def is_cloudformation_event(user_info):
    """Check if the event was performed by a CloudFormation role"""
    if not user_info:
        return False
    
    if user_info['identity_type'] == 'AssumedRole':
        if 'AWSServiceRoleForCloudFormation' in user_info.get('assumed_role_arn', ''):
            return True
        if 'cloudformation.amazonaws.com' in user_info.get('assumed_role_arn', ''):
            return True
    
    if user_info['identity_type'] == 'IAMUser':
        if user_info.get('username', '').startswith('AWSServiceRoleForCloudFormation'):
            return True
    
    return False

def main():
    print("Fetching security group changes from AWS Config...")
    sg_changes = get_security_group_changes()
    print(f"Found {len(sg_changes)} security group changes to analyze")
    
    results = []
    
    for i, change in enumerate(sg_changes):
        print(f"Processing change {i+1}/{len(sg_changes)}: {change['resourceId']}")
        
        try:
            user_info = get_user_info_for_change(change)
            if user_info and not is_cloudformation_event(user_info):
                combined = {
                    'resource_id': change['resourceId'],
                    'region': change['awsRegion'],
                    'account_id': change['awsAccountId'],
                    'change_time': change['configurationItemCaptureTime'],
                    'config_event_name': change.get('configuration.eventName', ''),
                    **user_info
                }
                results.append(combined)
        except Exception as e:
            print(f"Error processing change {change['resourceId']}: {str(e)}")
            continue
    
    if results:
        print(f"Saving {len(results)} results to {OUTPUT_CSV_FILE}")
        df = pd.DataFrame(results)
        
        # Reorder columns for better readability
        column_order = [
            'resource_id', 'region', 'account_id', 'change_time', 'eventtime',
            'identity_type', 'user_arn', 'principal_id', 'user_account_id',
            'username', 'assumed_role_arn', 'eventname', 'sourceipaddress',
            'useragent', 'config_event_name'
        ]
        df = df[[col for col in column_order if col in df.columns]]
        
        df.to_csv(OUTPUT_CSV_FILE, index=False, quoting=csv.QUOTE_ALL)
        print("Done!")
    else:
        print("No matching events found after filtering CloudFormation roles")

if __name__ == '__main__':
    main()
